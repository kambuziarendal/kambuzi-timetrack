{
  "name": "kambuzi-timeforing",
  "private": true,
  "version": "1.0.0-beta.5",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/kambuziarendal/kambuzi-timetrack",
  "repository": {
    "type": "git",
    "url": "https://github.com/kambuziarendal/kambuzi-timetrack.git"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "dev": "npm-run-all --parallel dev:backend dev:frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "lint": "npm run lint --workspace backend && npm run lint --workspace frontend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "test:subpath": "node scripts/check-subpath-build.mjs",
    "test:e2e": "./scripts/playwright-nb-no.sh",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.6.2"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
